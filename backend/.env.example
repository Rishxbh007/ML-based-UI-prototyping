# ------------------------------------------------------------------
# Morph backend configuration. Copy this file to `.env` and edit.
# The application runs fully WITHOUT any of these set — they only
# enable optional features (LLM refinement, alternate database).
# ------------------------------------------------------------------

# App
APP_ENV=development
API_PREFIX=/api

# CORS — the frontend dev origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Defaults to a local SQLite file. To use PostgreSQL instead,
# set e.g. postgresql+psycopg://user:pass@localhost:5432/morph
DATABASE_URL=sqlite:///./morph.db

# ---- Optional: AI (LLM) features -----------------------------------
# When enabled, the LLM powers two things:
#   1. AI Refinement — parsing free-text edit instructions.
#   2. Per-request content — authoring request-specific screen copy
#      (feed items, detail text, reviews, hero) instead of the built-in
#      per-domain library.
# Leave LLM_PROVIDER empty (or "none") and the app runs fully offline:
#   refinement falls back to rules, content falls back to the library.
# Supported: none | openai | gemini
#
# To turn ON Gemini:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=<your Google AI Studio key>
#   LLM_MODEL=gemini-2.0-flash       # a fast, low-cost flash model
#   ...then: pip install google-generativeai  (uncomment it in requirements.txt)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
